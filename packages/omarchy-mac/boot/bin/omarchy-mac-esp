#!/bin/bash

# omarchy:summary=Print where the system ESP of this Apple Silicon Mac is mounted
# omarchy:hidden=true

# Limine, its menu and the UKI live on the ESP that U-Boot boots from. Omarchy
# mounts it at /boot/efi; installs from before that, and Asahi's own images,
# mount it at /boot, where the kernels share the filesystem with it. The ESP is
# the partition named by the Asahi or Gravity device-tree property, mounted
# whole at /boot/efi or /boot. Without either name, use the FAT filesystem
# mounted whole at /boot/efi or /boot. Conflicting names fail closed.

set -uo pipefail

# Tests may name another device-tree node; root always reads the live one.
esp_node=/proc/device-tree/chosen/asahi,efi-system-partition
gravity_node=/proc/device-tree/chosen/gravity,efi-system-partition
if (( EUID != 0 )); then
  esp_node=${OMARCHY_ESP_PARTUUID_FILE:-$esp_node}
  gravity_node=${OMARCHY_ESP_GRAVITY_PARTUUID_FILE:-$gravity_node}
fi

esp_uuid="" gravity_uuid=""
for node in "$esp_node" "$gravity_node"; do
  if [[ -e $node ]]; then
    [[ -r $node ]] || { echo "omarchy-mac-esp: cannot read the system ESP identifier" >&2; exit 1; }
    value=$(tr -d '\0' <"$node" | tr '[:upper:]' '[:lower:]')
    [[ -n $value ]] || { echo "omarchy-mac-esp: empty system ESP identifier" >&2; exit 1; }
    if [[ $node == "$esp_node" ]]; then esp_uuid=$value; else gravity_uuid=$value; fi
  fi
done
if [[ -n $esp_uuid && -n $gravity_uuid && $esp_uuid != "$gravity_uuid" ]]; then
  echo "omarchy-mac-esp: Asahi and Gravity system ESP identifiers disagree" >&2
  exit 1
fi
esp_uuid=${esp_uuid:-$gravity_uuid}

for candidate in /boot/efi /boot; do
  findmnt -n -r -o FSTYPE,FSROOT,PARTUUID --mountpoint "$candidate" 2>/dev/null |
    awk -v uuid="$esp_uuid" '$1 == "vfat" && $2 == "/" && (uuid == "" || tolower($3) == uuid) { found = 1 } END { exit !found }' ||
    continue
  printf '%s\n' "$candidate"
  exit 0
done

echo "omarchy-mac-esp: the system ESP${esp_uuid:+ (PARTUUID=$esp_uuid)} is not mounted at /boot/efi or /boot" >&2
exit 1
