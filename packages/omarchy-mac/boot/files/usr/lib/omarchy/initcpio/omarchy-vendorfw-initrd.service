[Unit]
Description=Load Apple vendor firmware from the EFI system partition before disk unlock
DefaultDependencies=no
After=systemd-modules-load.service systemd-udevd.service
Wants=cryptsetup-pre.target
Before=cryptsetup-pre.target initrd-root-device.target
JobTimeoutSec=90s
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=60s
ExecStart=/usr/lib/omarchy/initcpio/omarchy-vendorfw-initrd.sh

[Install]
WantedBy=initrd-root-device.target sysinit.target
