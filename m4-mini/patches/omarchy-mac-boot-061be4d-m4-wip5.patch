@@ -0,0 +1,44 @@
+#!/bin/bash
+# Bind the fresh M4 image's update-m1n1 config to the ESP chosen by stage one.
+set -euo pipefail
+compatible=/proc/device-tree/compatible
+chosen=/proc/device-tree/chosen
+config=/etc/m1n1.conf
+helper=/usr/lib/omarchy/initcpio/omarchy-vendorfw-device.sh
+modules=/usr/lib/modules
+if (( EUID != 0 )); then
+  compatible=${OMARCHY_M4_COMPATIBLE_FILE:-$compatible}
+  chosen=${OMARCHY_M4_CHOSEN_DIR:-$chosen}
+  config=${OMARCHY_M4_CONFIG_FILE:-$config}
+  helper=${OMARCHY_M4_VENDORFW_HELPER:-$helper}
+  modules=${OMARCHY_M4_MODULES_ROOT:-$modules}
+fi
+release=$(uname -r)
+[[ -n $release && $release != */* && $release != . && $release != .. &&
+   -r $modules/$release/pkgbase && $(<"$modules/$release/pkgbase") == linux-omarchy-m4-wip5 &&
+   -r $compatible ]] || exit 0
+tr '\0' '\n' <"$compatible" | grep -Fxq 'apple,j773g' || exit 0
+[[ -r $helper && -r $chosen/asahi,efi-system-partition && -r $chosen/gravity,efi-system-partition ]] || {
+  echo 'M4 ESP binding: both booted ESP identifiers are required' >&2; exit 1;
+}
+# shellcheck source=/dev/null
+source "$helper"
+esp=$(omarchy_vendorfw_chosen_esp "$chosen") || { echo 'M4 ESP binding: conflicting ESP identifiers' >&2; exit 1; }
+[[ $esp =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || {
+  echo 'M4 ESP binding: invalid ESP identifier' >&2; exit 1;
+}
+[[ ! -L $config && ( ! -e $config || -f $config ) ]] || { echo 'M4 ESP binding: invalid configuration file' >&2; exit 1; }
+expected=$(printf 'chosen.gravity,efi-system-partition=%s\nchosen.asahi,efi-system-partition=%s\n' "$esp" "$esp")
+actual=""
+if [[ -f $config ]]; then
+  actual=$(awk '/^[[:space:]]*(chosen\.[^=]*=|display=|mitigations=)/ { sub(/^[[:space:]]+/, ""); print }' "$config")
+fi
+[[ $actual != "$expected" ]] || exit 0
+[[ -z $actual ]] || { echo 'M4 ESP binding: existing m1n1 options need manual review' >&2; exit 1; }
+tmp=$(mktemp "${config}.m4.XXXXXX")
+trap 'rm -f "$tmp"' EXIT
+[[ ! -f $config ]] || cat "$config" >"$tmp"
+if [[ -s $tmp && $(tail -c 1 "$tmp" | wc -l) -eq 0 ]]; then printf '\n' >>"$tmp"; fi
+printf '%s\n' "$expected" >>"$tmp"
+chmod 0644 "$tmp"
+mv -f "$tmp" "$config"
