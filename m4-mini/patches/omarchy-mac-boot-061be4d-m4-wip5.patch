+#!/bin/bash
+set -euo pipefail
+source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/base-test.sh"
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+python3 - "$tmp" <<'PY'
+import gzip,sys
+from pathlib import Path
+p=Path(sys.argv[1]);loader=b'm1n1';dtb=b'device-tree';uboot=b'uboot'*500;options=b'chosen.gravity,efi-system-partition=test\n'
+for name,data in [('loader',loader),('dtb',dtb),('uboot',uboot),('options',options)]: (p/name).write_bytes(data)
+(p/'stage2').write_bytes(loader+dtb+gzip.compress(uboot,mtime=0)+options)
+(p/'wrong').write_bytes(loader+dtb+gzip.compress(uboot+b'bad',mtime=0)+options)
+(p/'extra').write_bytes(loader+dtb+gzip.compress(uboot,mtime=1)+options+b'extra')
+PY
+check=$ROOT/bin/omarchy-mac-m4-stage2-check
+"$check" "$tmp/stage2" "$tmp/loader" "$tmp/dtb" "$tmp/uboot" "$tmp/options" || fail 'equivalent gzip stage two passes'
+for bad in wrong extra; do
+  if "$check" "$tmp/$bad" "$tmp/loader" "$tmp/dtb" "$tmp/uboot" "$tmp/options"; then fail 'different U-Boot or trailing options are refused'; fi
+done
+pass 'M4 stage-two check verifies every component independent of gzip headers'
