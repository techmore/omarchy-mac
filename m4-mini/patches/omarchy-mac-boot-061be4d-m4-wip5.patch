diff --git a/bin/omarchy-mac-m4-limine-menu-check b/bin/omarchy-mac-m4-limine-menu-check
new file mode 100755
index 0000000000000000000000000000000000000000..a44a3a6cbd5dc7241c158ba1475f194621c8baba
--- /dev/null
+++ b/bin/omarchy-mac-m4-limine-menu-check
@@ -0,0 +1,48 @@
+#!/bin/bash
+
+# omarchy:summary=Check the default Limine menu entry for the M4 research kernel
+# omarchy:hidden=true
+
+# Fail closed for the narrow Omarchy layout we can verify. This does not
+# inspect one-shot EFI variables or prove that the entry will boot.
+set -euo pipefail
+(( $# == 2 )) && [[ $2 == "linux-omarchy-m4-wip5" && -f $1 ]] || exit 1
+awk -v kernel="$2" '
+  {
+    line = $0
+    sub(/^[[:space:]]+/, "", line)
+    sub(/[[:space:]]+$/, "", line)
+  }
+  line ~ /^#/ || line == "" { next }
+  line ~ /^\// {
+    count++
+    if (count == 1) {
+      first = line
+      in_omarchy = (first == "/+Omarchy" || first == "/Omarchy")
+    } else if (line ~ /^\/[^\/]/) {
+      in_omarchy = 0
+    }
+    if (count == 2) second = line
+    if (in_omarchy && line == "//" kernel "-fallback") fallbacks++
+    next
+  }
+  count == 0 {
+    lower = tolower(line)
+    if (lower ~ /^default_entry[[:space:]]*:/) {
+      sub(/^[^:]*:[[:space:]]*/, "", lower)
+      default_entry = lower
+      defaults++
+    }
+    if (lower ~ /^remember_last_entry[[:space:]]*:/) {
+      sub(/^[^:]*:[[:space:]]*/, "", lower)
+      remember = lower
+      remembers++
+    }
+  }
+  END {
+    ok = defaults == 1 && default_entry == "2" && remembers <= 1 &&
+      (remembers == 0 || remember == "no") &&
+      (first == "/+Omarchy" || first == "/Omarchy") && second == "//" kernel && fallbacks == 1
+    exit !ok
+  }
+' "$1"
diff --git a/bin/omarchy-mac-m4-stage2-check b/bin/omarchy-mac-m4-stage2-check
new file mode 100755
index 0000000000000000000000000000000000000000..3621c7197f6a6f609c49555585a19716ae1169c3
--- /dev/null
+++ b/bin/omarchy-mac-m4-stage2-check
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""Verify M4 stage-two components while allowing equivalent gzip headers."""
+from pathlib import Path
+import sys
+import zlib
+
+
+def main():
+    if len(sys.argv) != 6:
+        return 2
+    try:
+        image, loader, dtb, uboot, options = (Path(p).read_bytes() for p in sys.argv[1:])
+        prefix = loader + dtb
+        if not loader or not dtb or not uboot or not image.startswith(prefix):
+            return 1
+        stream = zlib.decompressobj(16 + zlib.MAX_WBITS)
+        payload = stream.decompress(image[len(prefix):], len(uboot) + 1)
+        if not stream.eof or stream.unconsumed_tail or payload != uboot or stream.unused_data != options:
+            return 1
+    except (OSError, ValueError, zlib.error):
+        return 1
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
