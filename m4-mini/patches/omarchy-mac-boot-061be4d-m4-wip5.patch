@@ -0,0 +1,30 @@
+# Select the WIP5 target using the module package identity, not the build host.
+# Include the required root-storage and early display modules when available.
+# The driver checks do not establish working M4 graphics or HDMI.
+# A missing critical driver must fail the build; a built-in needs no MODULES
+# entry. modinfo -b follows mkinitcpio -r when building against a staged root.
+if [[ -n ${KERNELVERSION:-} && $KERNELVERSION != */* && $KERNELVERSION != . && $KERNELVERSION != .. ]]; then
+  _omarchy_m4_root=${_optmoduleroot:-/}
+  _omarchy_m4_pkgbase="${_omarchy_m4_root%/}/lib/modules/$KERNELVERSION/pkgbase"
+  _omarchy_m4_target=false
+  if [[ -r $_omarchy_m4_pkgbase && $(<"$_omarchy_m4_pkgbase") == linux-omarchy-m4-wip5 ]]; then
+    _omarchy_m4_target=true
+  elif [[ $KERNELVERSION == *-wip5-m4*-ARCH ]]; then
+    echo 'M4 initramfs: target kernel package identity is missing or incorrect' >&2
+    return 1
+  fi
+  if [[ $_omarchy_m4_target == true ]]; then
+  for _omarchy_m4_module in nvme-apple apple-mailbox apple-dart btrfs appledrm asahi phy-apple-dptx; do
+    _omarchy_m4_path=$(modinfo -b "$_omarchy_m4_root" -k "$KERNELVERSION" -F filename "$_omarchy_m4_module" 2>/dev/null) || {
+      echo "M4 initramfs: required driver $_omarchy_m4_module is unavailable" >&2
+      return 1
+    }
+    case $_omarchy_m4_path in
+      '(builtin)') ;;
+      /*) MODULES+=("$_omarchy_m4_module") ;;
+      *) echo "M4 initramfs: invalid driver path for $_omarchy_m4_module" >&2; return 1 ;;
+    esac
+  done
+  fi
+  unset _omarchy_m4_root _omarchy_m4_pkgbase _omarchy_m4_target _omarchy_m4_module _omarchy_m4_path
+fi
