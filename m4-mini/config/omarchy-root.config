# Omarchy's systemd initramfs expects these drivers for encrypted Btrfs roots.
# This is a separate research configuration; it does not authorize deployment.
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_DM_INTEGRITY=m
CONFIG_CRYPTO_AES=m
CONFIG_CRYPTO_XTS=m
CONFIG_CRYPTO_HMAC=m
CONFIG_CRYPTO_SHA256=m
CONFIG_BTRFS_FS=m
CONFIG_OVERLAY_FS=m
