#!/usr/bin/env python3
"""Check the isolated M4 research source and optional resolved kernel config."""
import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import sys

LOCK = Path(__file__).resolve().parents[1] / 'm4-mini/source-lock.json'


def check_source(source, lock):
    head = subprocess.check_output(['git', '-C', str(source), 'rev-parse', 'HEAD'], text=True).strip()
    if head != lock['kernel']['commit']:
        raise ValueError('kernel HEAD does not match the locked candidate')
    status = subprocess.check_output(['git', '-C', str(source), 'status', '--porcelain', '--ignored', '--untracked-files=normal'], text=True)
    if status:
        raise ValueError('kernel source tree must be clean; build outside the checkout')
    for name, expected in lock['file_sha256'].items():
        path = source / name
        if hashlib.sha256(path.read_bytes()).hexdigest() != expected:
            raise ValueError(f'source digest mismatch: {name}')


def check_config(path, extra=None):
    values = {}
    for line in path.read_text().splitlines():
        if line.startswith('CONFIG_') and '=' in line:
            key, value = line.split('=', 1)
            values[key] = value
    for key in ('CONFIG_ARCH_APPLE', 'CONFIG_ARM64_16K_PAGES', 'CONFIG_RUST'):
        if values.get(key) != 'y':
            raise ValueError(f'{key} must be enabled')
    for key in ('CONFIG_DRM_APPLE', 'CONFIG_DRM_ASAHI_M4', 'CONFIG_PHY_APPLE_DPTX'):
        if values.get(key) not in ('y', 'm'):
            raise ValueError(f'{key} must be built in or modular')
    for key, allowed in (extra or {}).items():
        if values.get(key) not in allowed:
            raise ValueError(f'{key} must be one of {allowed}')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('source', type=Path, help='clean candidate kernel Git checkout')
    parser.add_argument('--config', type=Path, help='resolved kernel .config, built out of tree')
    parser.add_argument('--lock', type=Path, default=LOCK, help='candidate source lock (default: baseline)')
    args = parser.parse_args()
    try:
        lock = json.loads(args.lock.read_text())
        check_source(args.source, lock)
        if args.config:
            check_config(args.config, lock.get('required_config'))
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f'M4 source check failed: {exc}', file=sys.stderr)
        return 1
    print('M4 source' + (' and config' if args.config else '') + ' match the research candidate.')
    print('This check does not build, install, or qualify a kernel or boot chain.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
