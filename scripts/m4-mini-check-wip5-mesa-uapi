#!/usr/bin/env python3
"""Check that a Mesa source tree uses the selected kernel's Asahi UAPI."""
import argparse
import hashlib
from pathlib import Path
import sys


def read_header(path):
    if path.is_symlink() or not path.is_file():
        raise ValueError(f'header must be an unlinked regular file: {path}')
    data = path.read_bytes()
    if b'DRM_ASAHI_FEATURE_' not in data or b'DRM_ASAHI_SUBMIT' not in data:
        raise ValueError(f'not an Asahi DRM UAPI header: {path}')
    return data


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--kernel-header', type=Path, required=True)
    parser.add_argument('--mesa-header', type=Path, required=True)
    args = parser.parse_args()
    try:
        kernel = read_header(args.kernel_header)
        mesa = read_header(args.mesa_header)
        kernel_sha = hashlib.sha256(kernel).hexdigest()
        mesa_sha = hashlib.sha256(mesa).hexdigest()
        if kernel != mesa:
            raise ValueError(f'Asahi UAPI headers differ: kernel {kernel_sha}, Mesa {mesa_sha}')
    except (OSError, ValueError) as error:
        print(f'm4-mini-check-wip5-mesa-uapi: {error}', file=sys.stderr)
        return 1
    print(f'Asahi UAPI headers match: {kernel_sha}')
    print('Header identity alone does not qualify the GPU driver or Mesa runtime.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
