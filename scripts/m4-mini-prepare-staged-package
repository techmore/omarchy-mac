#!/usr/bin/env python3
"""Prepare a staging-only Arch package from the locked M4 research bundle.

The outer package stores the nested packages as files under /usr/share; it
does not install a kernel, run the bootloader updater, or activate anything.
"""
import argparse
import hashlib
import io
import json
from pathlib import Path
import sys
import tarfile

ROOT = Path(__file__).resolve().parents[1]
LOCKED = {
    'kernel/linux-omarchy-m4-research-7.1.13.r7.rootfix-1-aarch64.pkg.tar.gz': 'cc9fa5c49ea79e96f12bb05ac01084a5810b19f56fe8e4a93b9bc41d80ac7b0d',
    'bootloader/m1n1-omarchy-m4-research-1.6.1.r1-1-aarch64.pkg.tar.gz': '368409870fe34921b7e4ba667f5af619616428195f286bf648b750e15c5f80c3',
    'bootloader/boot-sample.bin': 'c04c1c67633775a2831fa551ed61e047f8f854e58621e5079fed7cd877ce9a16',
    'mesa/mesa-omarchy-m4-research-26.3.0.r1-2-aarch64.pkg.tar.xz': '2b5af4842e991b179bf0854e9f6973c05cd6a82095dec9261acd92568d385fe2',
    'omarchy-mac-boot-source.tar.gz': '62d22df6e8b2fcf691146ab8e851d585951c842585d0f4cfcd193ebed2f84bed',
    'scripts/m4-mini-prepare-boot-transition': '00b5ab1dc26ec8a347502e53e5a19a96109308770aec7287440e6fca29e7551d',
    'scripts/m4-mini-recovery-capsule': '1f10305b4f7666e8d0a01b6c4ea8f1430384e39b68358093d5d0b7439a1bdd46',
}


def digest(path):
    value = hashlib.sha256()
    with path.open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            value.update(chunk)
    return value.hexdigest()


def add_bytes(archive, name, content, mode=0o644):
    entry = tarfile.TarInfo('bundle/' + name)
    entry.size, entry.mode, entry.mtime = len(content), mode, 0
    entry.uid = entry.gid = 0
    entry.uname = entry.gname = 'root'
    archive.addfile(entry, io.BytesIO(content))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('bundle', type=Path)
    parser.add_argument('output', type=Path)
    args = parser.parse_args()
    try:
        if args.bundle.is_symlink() or not args.bundle.is_dir() or (args.bundle / 'INCOMPLETE').exists():
            raise ValueError('an intact, unlinked research bundle is required')
        bundle = args.bundle.resolve(strict=True)
        if args.output.exists() or args.output.is_symlink():
            raise ValueError('a new output directory is required')
        output = args.output.parent.resolve(strict=True) / args.output.name
        if output == bundle or bundle in output.parents or output in bundle.parents:
            raise ValueError('output must be separate from the input bundle')
        source_manifest = bundle / 'manifest.json'
        if source_manifest.is_symlink() or not source_manifest.is_file():
            raise ValueError('bundle manifest must be a regular file')
        manifest = json.loads(source_manifest.read_text())
        if manifest.get('hardware_validated') is not False:
            raise ValueError('unexpected bundle qualification state')
        for name, expected in LOCKED.items():
            path = bundle / name
            if (path.is_symlink() or not path.is_file() or not path.resolve().is_relative_to(bundle)
                    or manifest['files'].get(name) != expected or digest(path) != expected):
                raise ValueError(f'locked bundle artifact does not match: {name}')

        output.mkdir()
        marker = output / 'INCOMPLETE'
        marker.write_text('This staging recipe is incomplete.\n')
        archive_path = output / 'm4-staged-artifacts.tar.gz'
        staging_manifest = {
            'scope': 'staged nested research artifacts, not an active boot installation',
            'input_bundle_manifest_sha256': digest(source_manifest),
            'files': LOCKED, 'hardware_validated': False,
            'limitations': ['the nested packages are not installed', 'no boot or recovery activation',
                            'no M4 boot or HDMI validation'],
        }
        with tarfile.open(archive_path, 'w:gz', compresslevel=1) as archive:
            for name in sorted(LOCKED):
                add_bytes(archive, name, (bundle / name).read_bytes(), 0o755 if name.startswith('scripts/') else 0o644)
            add_bytes(archive, 'staging-manifest.json', (json.dumps(staging_manifest, indent=2, sort_keys=True) + '\n').encode())
            add_bytes(archive, 'README.txt', b'Staged research files only. The nested packages are not installed or qualified for activation.\n')
        source_sha = digest(archive_path)
        template = (ROOT / 'm4-mini/arch-research/PKGBUILD-staged.in').read_text()
        (output / 'PKGBUILD').write_text(template.replace('@SOURCE_SHA256@', source_sha))
        (output / 'receipt.json').write_text(json.dumps({
            'scope': 'unbuilt staging-only Arch package recipe', 'source_sha256': source_sha,
            'source_bundle_manifest_sha256': digest(source_manifest), 'hardware_validated': False,
        }, indent=2, sort_keys=True) + '\n')
        marker.unlink()
    except (OSError, ValueError, KeyError, TypeError, tarfile.TarError) as error:
        print(f'm4-mini-prepare-staged-package: {error}', file=sys.stderr)
        return 1
    print('Prepared staging-only M4 package recipe; no nested packages were installed.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
