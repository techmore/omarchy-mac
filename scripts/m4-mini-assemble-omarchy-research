#!/usr/bin/env python3
"""Assemble an offline M4 integration bundle; never install or alter a boot device."""
import argparse
import gzip
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile

ROOT = Path(__file__).resolve().parents[1]
KVER = '7.1.13-omarchy-m4-r7-rootfix-ARCH'
BOOT_COMMIT = 'b8ce4c47ddbf5f8d6b4e5305e899d0105b58a30a'
UAPI_SHA = 'eb9f39e87dfe448dc044f54ab2d11b7493bf1359faca8fb76ece5f3583469015'
EXPECTED = {
    'kernel': 'cc9fa5c49ea79e96f12bb05ac01084a5810b19f56fe8e4a93b9bc41d80ac7b0d',
    'loader': '368409870fe34921b7e4ba667f5af619616428195f286bf648b750e15c5f80c3',
    'boot': 'c04c1c67633775a2831fa551ed61e047f8f854e58621e5079fed7cd877ce9a16',
    'mesa-source': 'a223413cb6128c1cef528f05dfe14940da09f88de68497d59dd6560beaf32778',
    'mesa-launcher': '508c8636a0651a2f267a0e009ad9e15f1c7e1ea839b81a7311a96f76d12603b7',
    'mesa-uwsm': 'f8b7f005b60bc8e29ed546b13605ac634a690992a7a0629f130cf6a5047aab54',
    'mesa-uwsm-loader': '921f6fdcd7412ab2522613c24c78838b502f4c08dd5166ac31805f1ebbdaccc4',
}


def sha_file(path):
    value = hashlib.sha256()
    with path.open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            value.update(chunk)
    return value.hexdigest()


def member(archive, name):
    matches = [item for item in archive.getmembers() if item.name == name and item.isfile()]
    if len(matches) != 1:
        raise ValueError(f'package does not contain exactly one regular {name}')
    with archive.extractfile(matches[0]) as stream:
        return stream.read()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--kernel-package', required=True, type=Path)
    parser.add_argument('--loader-package', required=True, type=Path)
    parser.add_argument('--boot-sample', required=True, type=Path)
    parser.add_argument('--mesa-prepared', required=True, type=Path)
    parser.add_argument('--output', required=True, type=Path)
    args = parser.parse_args()
    sources = {
        'kernel': args.kernel_package, 'loader': args.loader_package, 'boot': args.boot_sample,
        'mesa-source': args.mesa_prepared / 'm4-mesa-source.tar.gz',
        'mesa-launcher': args.mesa_prepared / 'm4-mini-run-mesa',
        'mesa-uwsm': args.mesa_prepared / 'm4-mesa-uwsm-env',
        'mesa-uwsm-loader': args.mesa_prepared / 'm4-mesa-uwsm-loader',
        'mesa-recipe': args.mesa_prepared / 'PKGBUILD',
        'recovery-capsule': ROOT / 'scripts/m4-mini-recovery-capsule',
        'boot-transition': ROOT / 'scripts/m4-mini-prepare-boot-transition',
    }
    try:
        if args.output.exists() or args.output.is_symlink():
            raise ValueError('a new output directory is required')
        boot_path = 'packages/omarchy-mac/boot'
        dirty = subprocess.check_output(['git', '-C', str(ROOT), 'status', '--porcelain', '--untracked-files=normal', '--', boot_path], text=True)
        if dirty:
            raise ValueError('Omarchy Mac boot source must be committed before bundling')
        locked_tree = subprocess.check_output(['git', '-C', str(ROOT), 'rev-parse', f'{BOOT_COMMIT}:{boot_path}'], text=True).strip()
        head_tree = subprocess.check_output(['git', '-C', str(ROOT), 'rev-parse', f'HEAD:{boot_path}'], text=True).strip()
        if head_tree != locked_tree:
            raise ValueError('Omarchy Mac boot source differs from the locked integration bundle')
        boot_source = subprocess.check_output(['git', '-C', str(ROOT), 'archive', '--format=tar', BOOT_COMMIT, boot_path])
        if (args.mesa_prepared / 'INCOMPLETE').exists():
            raise ValueError('Mesa preparation is incomplete')
        template = (ROOT / 'm4-mini/arch-research/PKGBUILD-mesa.in').read_text()
        recipe = (template.replace('@SOURCE_SHA256@', EXPECTED['mesa-source'])
                  .replace('@LAUNCHER_SHA256@', EXPECTED['mesa-launcher'])
                  .replace('@UWSM_SHA256@', EXPECTED['mesa-uwsm'])
                  .replace('@UWSM_LOADER_SHA256@', EXPECTED['mesa-uwsm-loader']))
        expected = EXPECTED.copy()
        expected['mesa-recipe'] = hashlib.sha256(recipe.encode()).hexdigest()
        for name in ('recovery-capsule', 'boot-transition'):
            path = sources[name]
            if path.is_symlink() or not path.is_file():
                raise ValueError(f'{name} must be a regular local script')
            expected[name] = sha_file(path)
        for name, path in sources.items():
            if path.is_symlink() or not path.is_file() or sha_file(path) != expected[name]:
                raise ValueError(f'{name} is missing, linked or does not match its locked hash')
        kernel_lock = json.loads((ROOT / 'm4-mini/source-lock-r7-rootfix.json').read_text())
        mesa_lock = json.loads((ROOT / 'm4-mini/mesa-source-lock.json').read_text())
        with tarfile.open(sources['mesa-source'], 'r:gz') as mesa_archive:
            mesa_uapi = member(mesa_archive, 'techmore-mesa-96a24da/include/drm-uapi/asahi_drm.h')
        if (kernel_lock['file_sha256'].get('include/uapi/drm/asahi_drm.h') != UAPI_SHA or
                mesa_lock.get('kernel_and_mesa_uapi_sha256') != UAPI_SHA or
                hashlib.sha256(mesa_uapi).hexdigest() != UAPI_SHA):
            raise ValueError('kernel and Mesa source locks do not share the expected Asahi UAPI')
        with tarfile.open(args.kernel_package, 'r:*') as kernel, tarfile.open(args.loader_package, 'r:*') as loader:
            base = f'usr/lib/modules/{KVER}/'
            dtb = member(kernel, base + 'dtbs/apple/t8132-j773g.dtb')
            image = member(kernel, base + 'vmlinuz')
            stage2 = member(loader, 'usr/lib/asahi-boot/omarchy-m4-research/m1n1.bin')
            uboot = member(loader, 'usr/lib/asahi-boot/omarchy-m4-research/u-boot-nodtb.bin')
        if hashlib.sha256(dtb).hexdigest() != '734a8c22d441f3f00fc510289af273542dba9e59da06ab623b0816aa7950a1b3':
            raise ValueError('kernel package has the wrong J773g device tree')
        if ('Linux version ' + KVER + ' ').encode() not in image:
            raise ValueError('kernel package image has the wrong release')
        boot = args.boot_sample.read_bytes()
        offset = len(stage2) + len(dtb)
        if boot[:len(stage2)] != stage2 or boot[len(stage2):offset] != dtb or gzip.decompress(boot[offset:]) != uboot:
            raise ValueError('boot sample does not match the packaged stage 2, J773g tree and U-Boot')

        args.output.mkdir()
        marker = args.output / 'INCOMPLETE'
        marker.write_text('Do not use this incomplete bundle.\n')
        destinations = {
            'kernel': 'kernel/' + args.kernel_package.name,
            'loader': 'bootloader/' + args.loader_package.name,
            'boot': 'bootloader/boot-sample.bin',
            'mesa-source': 'mesa/m4-mesa-source.tar.gz',
            'mesa-launcher': 'mesa/m4-mini-run-mesa',
            'mesa-uwsm': 'mesa/m4-mesa-uwsm-env',
            'mesa-uwsm-loader': 'mesa/m4-mesa-uwsm-loader',
            'mesa-recipe': 'mesa/PKGBUILD',
            'recovery-capsule': 'scripts/m4-mini-recovery-capsule',
            'boot-transition': 'scripts/m4-mini-prepare-boot-transition',
        }
        for name, relative in destinations.items():
            destination = args.output / relative
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(sources[name], destination)
            if name in ('recovery-capsule', 'boot-transition'):
                destination.chmod(0o755)
            if sha_file(destination) != expected[name]:
                raise ValueError(f'copy verification failed: {name}')
        shutil.copyfile(ROOT / 'm4-mini/r7-rootfix-build-2026-10-30.json', args.output / 'kernel-build-receipt.json')
        (args.output / 'omarchy-mac-boot-source.tar.gz').write_bytes(gzip.compress(boot_source, mtime=0))
        (args.output / 'DO-NOT-INSTALL.txt').write_text(
            'RESEARCH ONLY: this bundle is not an installer. Packages are unsigned and unqualified.\n'
            'boot-sample.bin is not target-specific and must not be written to an ESP.\n'
            'The Mesa recipe is unbuilt on Arch. Boot, HDMI and recovery remain unverified.\n')
        manifest = {'scope': 'offline M4 Omarchy integration research; no deployment or hardware qualification',
                    'kernel_release': KVER, 'omarchy_boot_source_commit': BOOT_COMMIT,
                    'asahi_uapi_sha256': UAPI_SHA, 'hardware_validated': False,
                    'files': {relative: expected[name] for name, relative in destinations.items()},
                    'checks': ['package image release matches', 'locked kernel UAPI and Mesa archive header hashes match',
                               'J773g DTB matches the boot sample',
                               'stage 2 and decompressed U-Boot match the loader package'],
                    'limitations': ['unsigned packages', 'Mesa recipe unbuilt on Arch',
                                    'boot sample has no target-specific configuration',
                                    'no verified recovery, native boot or HDMI']}
        for name in ('kernel-build-receipt.json', 'omarchy-mac-boot-source.tar.gz', 'DO-NOT-INSTALL.txt'):
            manifest['files'][name] = sha_file(args.output / name)
        (args.output / 'manifest.json').write_text(json.dumps(manifest, indent=2, sort_keys=True) + '\n')
        marker.unlink()
    except (OSError, ValueError, tarfile.TarError, EOFError, subprocess.CalledProcessError) as error:
        print(f'm4-mini-assemble-omarchy-research: {error}', file=sys.stderr)
        return 1
    print('Offline M4 kernel, boot and Mesa research bundle assembled; nothing installed.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
