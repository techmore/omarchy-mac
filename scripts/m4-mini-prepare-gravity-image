#!/usr/bin/env python3
"""Create a research Gravity-installer image from an existing root and M4 UKIs.

The root and EFI inputs must already be built. This does not personalize an
Apple boot entry, access a device, or establish that the image can boot.
"""
import argparse
import hashlib
import json
from pathlib import Path
import runpy
import shutil
import sys
import zipfile

ROOT = Path(__file__).resolve().parents[1]


def digest(path):
    h = hashlib.sha256()
    with path.open('rb') as f:
        for data in iter(lambda: f.read(1024 * 1024), b''):
            h.update(data)
    return h.hexdigest()


def regular(path):
    if path.is_symlink() or not path.is_file() or path.stat().st_size == 0:
        raise ValueError(f'missing, empty or linked input: {path}')
    return path.resolve(strict=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ('root-image', 'esp-template', 'stage2-sample', 'stage1', 'output'):
        parser.add_argument('--' + name, type=Path, required=True)
    parser.add_argument('--boot-image', type=Path, help='separate ext4 boot image for a Btrfs Omarchy root')
    args = parser.parse_args()
    try:
        helper = runpy.run_path(str(ROOT / 'm4-mini/gravity-installer/omarchy_m4.py'))
        root, sample, stage1 = map(regular, (args.root_image, args.stage2_sample, args.stage1))
        boot = regular(args.boot_image) if args.boot_image is not None else None
        with root.open('rb') as stream:
            root_kind, expected_root_uuid = helper['filesystem_identity'](stream.read(0x10080))
        if (root_kind == 'btrfs') != (boot is not None):
            raise ValueError('a Btrfs Omarchy root requires a separate ext4 boot image')
        if args.esp_template.is_symlink() or not args.esp_template.is_dir():
            raise ValueError('ESP template must be an unlinked directory')
        esp = args.esp_template.resolve(strict=True)
        relpaths = ('EFI/BOOT/BOOTAA64.EFI', 'limine.conf',
                    'EFI/Linux/omarchy_linux-omarchy-m4-research.efi',
                    'EFI/Linux/omarchy_linux-omarchy-m4-research-fallback.efi')
        sources = {}
        for name in relpaths:
            path = esp / name
            if any((esp / Path(*Path(name).parts[:i])).is_symlink() for i in range(1, len(Path(name).parts) + 1)):
                raise ValueError(f'linked ESP template path: {name}')
            sources['esp/' + name] = regular(path)
        if (esp / 'INCOMPLETE').exists():
            raise ValueError('ESP template is incomplete')
        receipt_file = regular(esp / 'receipt.json')
        template_receipt = json.loads(receipt_file.read_text())
        if (template_receipt.get('root_uuid') != expected_root_uuid
                or template_receipt.get('root_filesystem') != root_kind
                or template_receipt.get('hardware_validated') is not False
                or template_receipt.get('ready_for_installation') is not False
                or template_receipt.get('files') != {name: digest(sources['esp/' + name]) for name in relpaths}):
            raise ValueError('ESP template receipt does not match its root and EFI files')
        sources['esp/m1n1/boot.bin'] = sample
        sources['root.img'] = root
        if boot is not None:
            sources['boot.img'] = boot
        if sum(path.stat().st_size for name, path in sources.items() if name.startswith('esp/')) > 512 * 1024 * 1024:
            raise ValueError('EFI payload leaves insufficient room for device firmware')
        if args.output.exists() or args.output.is_symlink():
            raise ValueError('output must be a new directory')
        output = args.output.parent.resolve(strict=True) / args.output.name
        if any(output == p or output in p.parents or p in output.parents
               for p in (esp, root, sample, stage1, *([boot] if boot is not None else []))):
            raise ValueError('output must be separate from every input')
        size = root.stat().st_size
        template = {'name': 'Omarchy M4 mini research image', 'default_os_name': 'Omarchy',
                    'boot_object': 'm1n1.bin', 'next_object': 'm1n1/boot.bin', 'omarchy_m4': True,
                    'package': 'omarchy-m4-research.zip', 'supported_fw': ['26.6.2'],
                    'partitions': [{'name': 'EFI', 'type': 'EFI', 'size': '1073741824B',
                                    'format': 'fat', 'copy_firmware': True,
                                    'copy_installer_data': True, 'source': 'esp', 'volume_id': '0x4f4d5801'},
                                   {'name': 'Root', 'type': 'Linux', 'size': f'{size}B',
                                    'expand': True, 'image': 'root.img'}]}
        if boot is not None:
            template['partitions'].insert(1, {'name': 'Boot', 'type': 'Linux',
                                               'size': f'{boot.stat().st_size}B', 'image': 'boot.img'})
        output.mkdir(mode=0o700)
        (output / 'INCOMPLETE').write_text('Incomplete installer image; do not run.\n')
        package = output / template['package']
        with zipfile.ZipFile(package, 'w', compression=zipfile.ZIP_DEFLATED, compresslevel=1, allowZip64=True) as archive:
            for name, path in sources.items():
                archive.write(path, name, compress_type=zipfile.ZIP_DEFLATED if name.endswith('.img') else zipfile.ZIP_STORED,
                              compresslevel=1)
        with zipfile.ZipFile(package) as archive:
            root_uuid = helper['preflight'](template, archive, stage1, size, boot.stat().st_size if boot else None)
        (output / 'installer_data.json').write_text(json.dumps({'os_list': [template]}, indent=2) + '\n')
        receipt = {'scope': 'offline research installer image; not a boot-qualified release',
                   'root_filesystem_uuid': root_uuid, 'root_filesystem': root_kind, 'root_image_sha256': digest(root),
                   'boot_image_sha256': digest(boot) if boot is not None else None,
                   'stage2_sample_sha256': digest(sample), 'stage1_sha256': digest(stage1),
                   'installer_image_sha256': digest(package),
                   'esp_input_sha256': {name: digest(path) for name, path in sources.items() if name.startswith('esp/')},
                   'hardware_validated': False, 'ready_for_installation': False,
                   'limitations': ['root contents and package dependencies are not qualified',
                                   'installer and root image have not been tested on the M4',
                                   'Gravity recovery has not been captured or restored',
                                   'Apple boot entry creation, firmware handoff and HDMI are untested']}
        (output / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
        (output / 'DO-NOT-INSTALL.txt').write_text('Research image only; no native boot or recovery validation.\n')
        (output / 'INCOMPLETE').unlink()
    except (OSError, ValueError, KeyError, TypeError, UnicodeError, zipfile.BadZipFile) as error:
        print(f'm4-mini-prepare-gravity-image: {error}', file=sys.stderr)
        return 1
    print('Prepared a local Gravity-format M4 research image; no device was modified.')
    return 0


if __name__ == '__main__':
    sys.exit(main())
